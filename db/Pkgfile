# Description: Berkeley DB embedded database system
# URL:         https://libdb.org/

name=db
version=5.3.29
release=1
source="db-$version.tar.gz::https://github.com/berkeleydb/libdb/archive/refs/tags/v$version.tar.gz
	db-5.3.21-memp_stat-upstream-fix.patch
	db-5.3.21-mutex_leak.patch
	db-5.3.28_cve-2019-2708.patch
	db-5.3.28-lemon_hash.patch
	db-5.3.28-mmap-high-cpu-usage.patch"

build() {
	for f in $SRC/*.patch; do
		patch -d libdb-$version -p1 -i $f
	done

	mkdir build; cd build

	../libdb-$version/dist/configure \
		--prefix=/usr \
		--enable-compat185 \
		--enable-shared \
		--enable-static \
		--enable-cxx \

	make V=1
	make DESTDIR=$PKG install

	# Remove junk
	rm -r $PKG/usr/docs

	# Fix permissions
	chmod -R +w $PKG
}
