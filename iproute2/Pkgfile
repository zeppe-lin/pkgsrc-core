# Description: IP routing utilities
# URL:         https://wiki.linuxfoundation.org/networking/iproute2
# Depends on:  db elfutils iptables libcap libtirpc

name=iproute2
version=7.1.0
release=1
source="https://git.kernel.org/pub/scm/network/$name/$name.git/snapshot/$name-$version.tar.gz
	rc.lo
	rc.net"

build() {
	# Build in separate dir is broken (configure is not autotools)
	cd $name-$version

	# Configure script uses TMPDIR for internal tests
	export TMPDIR=$PKGMK_WORK_DIR

	./configure

	make CCOPTS="$CFLAGS" V=1
	make DESTDIR=$PKG install

	# Install service scripts
	install -m 0755 -D $SRC/rc.lo  $PKG/etc/rc.d/lo
	install -m 0755 -D $SRC/rc.net $PKG/etc/rc.d/net

	# Add ip to user path via symlink
	mkdir -p $PKG/bin
	ln -s ../sbin/ip $PKG/bin/ip
}
