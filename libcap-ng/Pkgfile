# Description: Alternate POSIX capabilities library
# URL:         https://github.com/stevegrubb/libcap-ng

# Notes on dependencies:
#   --without-python3: disable python bindings, otherwise requires python3

name=libcap-ng
version=0.9.2
release=1
source="$name-$version.tar.gz::https://github.com/stevegrubb/$name/archive/refs/tags/v$version.tar.gz
	fix-bashcomp-path.patch"

build() {
	# Fix hardcoded bash-completion installation path
	patch -d $name-$version -p1 -i $SRC/fix-bashcomp-path.patch

	# Fix build
	touch $name-$version/NEWS

	mkdir build; cd build

	autoreconf -fiv ../$name-$version
	../$name-$version/configure \
		--prefix=/usr \
		--without-python3 \

	make V=1
	make DESTDIR=$PKG install
}
