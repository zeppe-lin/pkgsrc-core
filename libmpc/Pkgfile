# Description: C library for the arithmetic of complex numbers
# URL:         https://www.multiprecision.org/
# Depends on:  libmpfr

name=libmpc
version=1.4.1
release=1
source=https://ftp.gnu.org/gnu/mpc/mpc-$version.tar.xz

build() {
	mkdir build; cd build

	../mpc-$version/configure \
		--prefix=/usr \

	make V=1
	make DESTDIR=$PKG install

	# Remove junk
	rm -r $PKG/usr/share/info
	rmdir $PKG/usr/share
}
