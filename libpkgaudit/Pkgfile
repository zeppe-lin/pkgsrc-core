# Description: Library for package integrity audits
# URL:         https://github.com/zeppe-lin/libpkgaudit
# Depends on:  libpkgcore

name=libpkgaudit
version=1.0-293af97
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	for x in static shared; do
		meson setup build-$x $name-* \
			--prefix=/usr \
			--buildtype=plain \
			--wrap-mode=nodownload \
			-D default_library=$x \
			-D link_mode=$x \
			-D manpages=true \

		ninja -C build-$x -j ${JOBS:-1} -v
		DESTDIR=$PKG ninja -C build-$x install
	done
}
