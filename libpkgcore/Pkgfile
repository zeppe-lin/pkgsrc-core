# Description: Core package management library
# URL:         https://github.com/zeppe-lin/libpkgcore
# Depends on:  libarchive scdoc

name=libpkgcore
version=6.5-b6f1a1e
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	for x in static shared; do
		meson setup build-$x $name-* \
			--prefix=/usr \
			--buildtype=plain \
			--wrap-mode=nodownload \
			-D default_library=$x \
			-D link_mode=$x \
			-D extract_acl=false \
			-D extract_xattr=true \
			-D manpages=true \

		ninja -C build-$x -j ${JOBS:-1} -v
		DESTDIR=$PKG ninja -C build-$x install
	done
}
