# Description: Core package management library
# URL:         https://github.com/zeppe-lin/libpkgcore
# Depends on:  libarchive

name=libpkgcore
version=6.3-0047566
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	# Pick up system flags
	sed -ri '/^C..FLAGS/s/ = /+=/g' $name-*/config.mk

	# Build variant: enable xattr(7), acl(5) remains disabled
	make -C $name-* XATTR=y PREFIX=/usr DESTDIR=$PKG install
}
