# Description: Package ELF linkage impact analysis library
# URL:         https://github.com/zeppe-lin/libpkgimpact
# Depends on:  elfutils

name=libpkgimpact
version=0.2.0-4cee644 # keep in sync with revdep
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	for x in static shared; do
		meson setup build-$x $name-* \
			--prefix=/usr \
			--buildtype=plain \
			--wrap-mode=nodownload \
			-D default_library=$x \
			-D link_mode=$x \
			-D tests=enabled \
			-D tools=enabled \
			-D install_tools=false \
			-D man_pages=enabled \

		ninja -C build-$x -j ${JOBS:-1} -v
		meson test -C build-$x
		DESTDIR=$PKG ninja -C build-$x install
	done
}
