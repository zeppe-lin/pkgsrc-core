# Description: Installed package state and ownership library
# URL:         https://github.com/zeppe-lin/libpkgstate
# Depends on:  libpkgimage

name=libpkgstate
version=0.2.0-1aac43a
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	for x in static shared; do
		meson setup build-$x $name-* \
			--prefix=/usr \
			--buildtype=plain \
			--wrap-mode=nodownload \
			-D default_library=$x \
			-D link_mode=$x \
			-D tests=enabled \

		ninja -C build-$x -j ${JOBS:-1} -v
		meson test -C build-$x --print-errorlogs
		DESTDIR=$PKG ninja -C build-$x install
	done
}
