# Description: Reverse dependency auditing library
# URL:         https://github.com/zeppe-lin/librevdep
# Depends on:  elfutils scdoc

name=librevdep
version=5.1.2-2751575
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	for x in static shared; do
		meson setup build-$x $name-* \
			--prefix=/usr \
			--buildtype=plain \
			--wrap-mode=nodownload \
			-D default_library=$x \
			-D link_mode=$x \
			-D manpages=true \

		ninja -C build-$x -j ${JOBS:-1} -v
		DESTDIR=$PKG ninja -C build-$x install
	done
}
