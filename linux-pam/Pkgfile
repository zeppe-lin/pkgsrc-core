# Description: Pluggable Authentication Modules (PAM) for Linux
# URL:         https://github.com/linux-pam/linux-pam
# Depends on:  libnsl libxcrypt

name=linux-pam
version=1.7.2
release=1
source="https://github.com/$name/$name/releases/download/v$version/Linux-PAM-$version.tar.xz
	man-pages-1.7.2.tar.gz
	pam.common-account
	pam.common-auth
	pam.common-password
	pam.common-session
	pam.other"

build() {
	meson setup build Linux-PAM-$version \
		--prefix=/usr \
		--sbindir=/sbin \
		--libdir=/lib \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D securedir=/lib/security \
		-D vendordir=/etc \
		-D pam_userdb=disabled \
		-D docs=disabled \
		-D i18n=disabled \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	# Install man pages
	mkdir -p $PKG/usr/share
	mv $SRC/man $PKG/usr/share/man

	# Move pkgconfig to /usr/lib
	mv $PKG/lib/pkgconfig $PKG/usr/lib/

	# unix_chkpwd needs to be setuid root
	chmod u+s $PKG/sbin/unix_chkpwd

	# Install default PAM configs
	for f in $SRC/pam.*; do
		install -m 0644 -D $f $PKG/etc/pam.d/${f#*.}
	done

	# Remove junk
	rm -r $PKG/usr/lib/systemd
}
