# Description: Install shared files
# URL:         https://metacpan.org/pod/File::ShareDir::Install
# Depends on:  perl

name=p5-file-sharedir-install
version=0.14
release=2
source=https://cpan.metacpan.org/authors/id/E/ET/ETHER/File-ShareDir-Install-$version.tar.gz

build() {
	cd File-ShareDir-Install-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
			-o -name README \
		\) -delete \
		-o -type d -empty -delete
}
