# Description: Locate per-dist and per-module shared files
# URL:         https://metacpan.org/pod/File::ShareDir
# Depends on:  p5-file-sharedir-install p5-class-inspector

name=p5-file-sharedir
version=1.118
release=2
source=https://cpan.metacpan.org/authors/id/R/RE/REHSACK/File-ShareDir-$version.tar.gz

build() {
	cd File-ShareDir-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
			-o -name README \
		\) -delete \
		-o -type d -empty -delete
}
