# Description: Set of utilities to manage software packages
# URL:         https://github.com/zeppe-lin/pkgutils
# Depends on:  libpkgcore

name=pkgutils
version=7.0.0-b541121
release=2
source="https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz
	pkgadd.conf"

build() {
	# Conflicts with pkgchk package
	sed "/^executable('pkgchk',/d" -i $name-*/src/meson.build
	sed "s/'pkgchk', //" -i $name-*/man/meson.build

	meson setup build $name-* \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D b_ndebug=true \
		-D link_mode=static \
		-D manpages=true \
		-D bashcomp=true \
		-D vimfiles=true \
		-D tests=disabled \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	install -m 0644 -Dt $PKG/etc $SRC/pkgadd.conf
}
