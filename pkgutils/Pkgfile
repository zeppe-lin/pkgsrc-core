# Description: Set of utilities to manage software packages
# URL:         https://github.com/zeppe-lin/pkgutils
# Depends on:  libarchive scdoc

name=pkgutils
version=6.3-85bb8b9
release=1
source="https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz
	pkgadd.conf"

build() {
	# Pick up system flags
	sed -ri '/^(CXX|LD)FLAGS/s/ = /+=/g' $name-*/config.mk

	# Enable preserving packages' xattrs(7)
	sed -ri '/^#XATTR/s/^#//' $name-*/config.mk

	# Static build
	LDFLAGS="$LDFLAGS -static"
	LDFLAGS="$LDFLAGS $(pkg-config --static --libs libarchive)"

	make -C $name-* LDFLAGS="$LDFLAGS" DESTDIR=$PKG install

	install -m 0644 -Dt $PKG/etc $SRC/pkgadd.conf
}
