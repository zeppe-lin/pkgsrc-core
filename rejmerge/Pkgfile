# Description: Interactively resolve filesystem-staged package objects
# URL:         https://github.com/zeppe-lin/libpkgreconcile
# Depends on:  libpkgreconcile

name=rejmerge
version=0.2.0-2b4a8b2 # keep in sync with libpkgreconcile
release=1
source=https://github.com/zeppe-lin/libpkgreconcile/archive/${version#*-}/libpkgreconcile-$version.tar.gz

build() {
	meson setup build libpkgreconcile-* \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D default_library=static \
		-D link_mode=static \
		-D tests=disabled \
		-D install_tools=true \
		-D man_pages=enabled \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	# Conflicts with libpkgreconcile
	rm -r $PKG/usr/include $PKG/usr/lib $PKG/usr/share/man/man3
}
