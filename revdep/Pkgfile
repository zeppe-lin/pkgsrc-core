# Description: Check for missing or wrong libraries of installed packages
# URL:         https://github.com/zeppe-lin/revdep
# Depends on:  elfutils scdoc

name=revdep
version=5.0-4fcfff2
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	meson setup build $name-* \
		--prefix=/usr \
		--sysconfdir=/etc \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_lto=false \
		-D b_pie=true \
		-D link_mode=static \
		-D manpages=true \
		-D bashcomp=true \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install
}
