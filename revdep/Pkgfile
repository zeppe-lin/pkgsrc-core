# Description: Report installed packages with unresolved ELF dependencies
# URL:         https://github.com/zeppe-lin/libpkgimpact
# Depends on:  elfutils scdoc

name=revdep
version=0.2.0-4cee644 # keep in sync with libpkgimpact
release=1
source=https://github.com/zeppe-lin/libpkgimpact/archive/${version#*-}/libpkgimpact-$version.tar.gz

build() {
	meson setup build libpkgimpact-* \
		--prefix=/usr \
		--sysconfdir=/etc \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D b_ndebug=true \
		-D default_library=static \
		-D link_mode=static \
		-D tests=disabled \
		-D tools=enabled \
		-D install_tools=true \
		-D man_pages=enabled \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	# Conflicts with libpkgimpact
	rm -r $PKG/usr/include $PKG/usr/lib \
		$PKG/usr/share/man/man3 $PKG/usr/share/man/man7
}
