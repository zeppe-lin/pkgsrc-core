# Description: Seed the Linux kernel random number generator from seed files
# URL:         https://github.com/zeppe-lin/seedrng
# Depends on:  scdoc

name=seedrng
version=0.4.0-9d4bd5c
release=1
source=https://github.com/zeppe-lin/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	cd $name-*

	# Pick up system flags
	sed -ri '/^(C|LD)FLAGS/s/ = /+=/g' config.mk

	make PREFIX=/ MANPREFIX=/usr/share/man DESTDIR=$PKG \
		install
}
