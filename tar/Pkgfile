# Description: Utility used to store, backup, and transport files
# URL:         https://www.gnu.org/software/tar/tar.html
# Depends on:  acl

name=tar
version=1.35
release=2
source="https://ftpmirror.gnu.org/gnu/tar/tar-$version.tar.xz
	tar-1.35-acl-2.4.0.patch"

build() {
	# Fix build with acl 2.4.0
	patch -d $name-$version -p1 -i $SRC/tar-1.35-acl-2.4.0.patch

	mkdir build; cd build

	FORCE_UNSAFE_CONFIGURE=1 \
	../$name-$version/configure \
		--prefix= \
		--libexec=/usr/lib/tar \
		--mandir=/usr/share/man \
		--disable-nls \

	make V=1
	make DESTDIR=$PKG install

	# Remove junk
	rm -r $PKG/share/info
	rmdir $PKG/share
}
